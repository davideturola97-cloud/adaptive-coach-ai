# Copia questo file in .env.local e compila i due valori del tuo progetto Supabase
# (Supabase > Project Settings > API). Sono valori pubblici: la protezione dei dati
# è garantita dalle regole di sicurezza del database (RLS).
# Senza questi valori l'app parte in modalità dimostrativa.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Coach AI (solo lato server, mai con prefisso NEXT_PUBLIC_). Facoltativo: senza, il coach AI è spento.
OPENAI_API_KEY=
# Facoltativi: modello e limiti giornalieri per contenere i costi.
# OPENAI_MODEL=gpt-4.1-mini
# AI_DAILY_REQUESTS=60
# AI_DAILY_TOKENS=300000
# AI_DAILY_IMAGES=15
